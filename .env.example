# Copy this file to .env.local for local development.
# In Vercel, set these under Project Settings → Environment Variables instead.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon" public API key (Project Settings → API → Project API keys → anon/public)
VITE_SUPABASE_ANON_KEY=

# Optional. Use "demo" for a separate demo deployment such as demo.bideey.com.
# Leave blank or set to "production" for the real app.
VITE_APP_MODE=production
